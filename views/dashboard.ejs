<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Dashboard - XDigitalKita</title>
<meta name="description" content="Dashboard manajemen transaksi QRIS H2H XDigitalKita. Satu dashboard untuk alur pembayaran yang ringkas.">
<meta name="theme-color" content="#0b0b0c">
<meta name="application-name" content="XDigitalKita">
<link rel="canonical" href="https://xdigitalkita.my.id/dashboard">
<link rel="apple-touch-icon" href="/icon.svg">
<meta property="og:site_name" content="XDigitalKita">
<meta property="og:title" content="Dashboard - XDigitalKita">
<meta property="og:description" content="Satu dashboard untuk alur pembayaran yang ringkas.">
<meta property="og:url" content="https://xdigitalkita.my.id/dashboard">
<meta property="og:type" content="website">
<meta property="og:image" content="/images/hero_fintech_qris_1791210767750.jpg">
<link rel="icon" href="/icon.svg" type="image/svg+xml">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=Space+Grotesk:wght@500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/glass.css">
<meta name="telegram-channel-url" content="<%= telegramChannelUrl || '' %>">
<meta name="telegram-channel-title" content="<%= telegramChannelTitle || 'Channel Information' %>">
</head>
<body class="glass dark">

<header class="glass-header">
  <div class="brand">
    <a href="/" class="brand" style="text-decoration:none;">
      <span class="brand-mark">
        <img class="ui-icon" src="/icon.svg" alt="XDigitalKita">
      </span>
      <span>XDigitalKita</span>
    </a>
  </div>
  <div class="header-actions">
    <a class="icon-btn" href="/" aria-label="Beranda" title="Beranda">
      <svg class="ui-icon" viewBox="0 0 24 24" fill="none" stroke-width="2"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
    </a>
    <button class="icon-btn" id="themeBtn" type="button" aria-label="Ganti tema">
      <svg class="ui-icon" id="themeIcon" viewBox="0 0 24 24" fill="none" stroke-width="2"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/></svg>
    </button>
    <a class="avatar" href="/profile" aria-label="Profil"<% if (user.avatar) { %> style="background-image:url('<%= user.avatar %>')"<% } %>>
      <% if (!user.avatar) { %><%= user.name ? user.name[0].toUpperCase() : "U" %><% } %>
    </a>
  </div>
</header>

<main class="page">

  <!-- Saldo Card -->
  <section class="glass-card saldo-card">
    <div class="saldo-top">
      <div>
        <div class="saldo-label">
          <span>Saldo Tersedia</span>
          <button type="button" id="refreshSaldo" aria-label="Perbarui saldo" title="Perbarui saldo">
            <svg class="ui-icon" viewBox="0 0 24 24" fill="none" stroke-width="2"><path d="M20 11a8 8 0 0 0-14.5-4.5L4 8"/><path d="M4 4v4h4"/><path d="M4 13a8 8 0 0 0 14.5 4.5L20 16"/><path d="M20 20v-4h-4"/></svg>
          </button>
        </div>
        <div class="saldo-value tabular-nums" id="saldoValue">Rp <%= Number(user.saldo || 0).toLocaleString('id-ID') %></div>
        <div class="saldo-actions-row">
          <a href="/withdraw" class="glass-btn saldo-action small">
            <svg class="ui-icon" viewBox="0 0 24 24" fill="none" stroke-width="2"><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/></svg>
            <span>Tarik Saldo</span>
          </a>
          <a href="/qris" class="glass-btn secondary small" style="margin-left:0.5rem;">
            <svg class="ui-icon" viewBox="0 0 24 24" fill="none" stroke-width="2"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><path d="M14 14h3v3h-3zM17 17h3v3h-3z"/></svg>
            <span>Buat QRIS</span>
          </a>
        </div>
      </div>
      <div class="hero-wallet">
        <svg class="ui-icon" viewBox="0 0 24 24" fill="none" stroke-width="2"><path d="M4 7.5A2.5 2.5 0 0 1 6.5 5H18a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H6.5A2.5 2.5 0 0 1 4 16.5z"/><path d="M4 8h13a3 3 0 0 1 3 3v4H15a3 3 0 0 1 0-6h5"/><path d="M16 12h.01"/></svg>
      </div>
    </div>
  </section>

  <!-- Quick Action Grid -->
  <section class="action-grid" style="display:grid;grid-template-columns:repeat(4,1fr);gap:0.6rem;margin-bottom:0.85rem;">
    <a href="/qris" class="glass-card action-tile" style="padding:0.75rem 0.5rem;text-align:center;text-decoration:none;margin-bottom:0;">
      <div class="action-tile-icon" style="color:#38bdf8;margin-bottom:0.35rem;">
        <svg class="ui-icon animated-icon" viewBox="0 0 24 24" fill="none" stroke-width="2"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><path d="M14 14h3v3h-3zM17 17h3v3h-3z"/></svg>
      </div>
      <span style="font-size:0.72rem;font-weight:700;">Buat QRIS</span>
    </a>
    <a href="/withdraw" class="glass-card action-tile" style="padding:0.75rem 0.5rem;text-align:center;text-decoration:none;margin-bottom:0;">
      <div class="action-tile-icon" style="color:#34d399;margin-bottom:0.35rem;">
        <svg class="ui-icon animated-icon" viewBox="0 0 24 24" fill="none" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
      </div>
      <span style="font-size:0.72rem;font-weight:700;">Tarik Dana</span>
    </a>
    <a href="/docs" class="glass-card action-tile" style="padding:0.75rem 0.5rem;text-align:center;text-decoration:none;margin-bottom:0;">
      <div class="action-tile-icon" style="color:#818cf8;margin-bottom:0.35rem;">
        <svg class="ui-icon animated-icon" viewBox="0 0 24 24" fill="none" stroke-width="2"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>
      </div>
      <span style="font-size:0.72rem;font-weight:700;">API H2H</span>
    </a>
    <a href="/profile" class="glass-card action-tile" style="padding:0.75rem 0.5rem;text-align:center;text-decoration:none;margin-bottom:0;">
      <div class="action-tile-icon" style="color:#fbbf24;margin-bottom:0.35rem;">
        <svg class="ui-icon animated-icon" viewBox="0 0 24 24" fill="none" stroke-width="2"><circle cx="12" cy="8" r="3"/><path d="M5 20c1.5-4 12.5-4 14 0"/></svg>
      </div>
      <span style="font-size:0.72rem;font-weight:700;">Profil Saya</span>
    </a>
  </section>

  <!-- Summary Card -->
  <section class="glass-card summary-card" id="summary">
    <div class="summary-head">
      <h2>Ringkasan Hari Ini</h2>
      <span class="date-pill"><%= new Date().toLocaleDateString('id-ID', { weekday: 'long', day: 'numeric', month: 'long' }) %></span>
    </div>
    <div class="summary-grid">
      <div class="summary-cell">
        <span>Masuk Hari Ini</span>
        <strong class="tabular-nums">Rp <%= stats.todayIncome.toLocaleString('id-ID') %></strong>
      </div>
      <div class="summary-cell">
        <span>TRX Sukses</span>
        <strong class="tabular-nums"><%= stats.todayTransactions %> transaksi</strong>
      </div>
      <div class="summary-cell">
        <span>Rata-rata/TRX</span>
        <strong class="tabular-nums">Rp <%= stats.todayAverage.toLocaleString('id-ID') %></strong>
      </div>
    </div>
  </section>

  <!-- Stats Grid -->
  <section class="stats-grid">
    <div class="stat-card">
      <div class="stat-top">
        <span>Total Transaksi</span>
        <div class="stat-icon"><svg class="ui-icon" viewBox="0 0 24 24" fill="none" stroke-width="2"><path d="M5 20V10M12 20V4M19 20v-7"/></svg></div>
      </div>
      <strong class="tabular-nums"><%= stats.total %></strong>
    </div>

    <div class="stat-card success">
      <div class="stat-top">
        <span>Berhasil</span>
        <div class="stat-icon"><svg class="ui-icon" viewBox="0 0 24 24" fill="none" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg></div>
      </div>
      <strong class="tabular-nums"><%= stats.successful %></strong>
    </div>

    <div class="stat-card pending">
      <div class="stat-top">
        <span>Pending</span>
        <div class="stat-icon"><svg class="ui-icon" viewBox="0 0 24 24" fill="none" stroke-width="2"><circle cx="12" cy="12" r="8"/><polyline points="12 6 12 12 14 14"/></svg></div>
      </div>
      <strong class="tabular-nums"><%= stats.pending %></strong>
    </div>

    <div class="stat-card failed">
      <div class="stat-top">
        <span>Gagal</span>
        <div class="stat-icon"><svg class="ui-icon" viewBox="0 0 24 24" fill="none" stroke-width="2"><circle cx="12" cy="12" r="8"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg></div>
      </div>
      <strong class="tabular-nums"><%= stats.failed %></strong>
    </div>

    <div class="stat-card income">
      <div class="stat-top">
        <span>Total Pemasukan</span>
        <div class="stat-icon"><svg class="ui-icon" viewBox="0 0 24 24" fill="none" stroke-width="2"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg></div>
      </div>
      <strong class="tabular-nums">Rp <%= stats.totalIncome.toLocaleString('id-ID') %></strong>
    </div>

    <div class="stat-card fee">
      <div class="stat-top">
        <span>Biaya Layanan</span>
        <div class="stat-icon"><svg class="ui-icon" viewBox="0 0 24 24" fill="none" stroke-width="2"><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/><rect x="8" y="2" width="8" height="4" rx="1"/></svg></div>
      </div>
      <strong class="tabular-nums">Rp <%= stats.totalFee.toLocaleString('id-ID') %></strong>
    </div>
  </section>

  <!-- Live Status Card -->
  <section class="glass-card status-card">
    <div class="section-title">
      <h2>Status Sistem &amp; Node</h2>
      <span class="live-badge"><span class="status-dot"></span> LIVE</span>
    </div>
    <div class="status-head">
      <div class="status-main">
        <i class="status-dot"></i>
        <div><strong>Beroperasi Normal</strong><span>Database JSON lokal aktif &amp; sinkron</span></div>
      </div>
      <svg class="ui-icon" viewBox="0 0 24 24" fill="none" stroke-width="2" style="color:#22c55e;"><polyline points="20 6 9 17 4 12"/></svg>
    </div>
    <div class="status-list">
      <div class="status-row"><span class="status-service"><i></i>Gateway QRIS BuatQRIS</span><span class="status-ok">Normal</span></div>
      <div class="status-row"><span class="status-service"><i></i>Local JSON Storage</span><span class="status-ok">Optimal</span></div>
      <div class="status-row"><span class="status-service"><i></i>Telegram Bot &amp; Broadcast</span><span class="status-ok">Normal</span></div>
    </div>
  </section>

  <!-- Transaksi Terbaru -->
  <section class="glass-card" id="transactions">
    <div class="section-title">
      <h2>Transaksi Terbaru</h2>
      <span class="section-link">Ketuk baris untuk detail</span>
    </div>
    <div class="tx-list" id="txList">
      <% if (!transactions.length) { %>
        <div class="empty-state">
          <svg class="ui-icon" viewBox="0 0 24 24" fill="none" stroke-width="1.5" style="width:36px;height:36px;margin:0 auto 0.5rem;color:var(--text-muted);"><rect x="2" y="5" width="20" height="14" rx="2"/><line x1="2" y1="10" x2="22" y2="10"/></svg>
          <div>Belum ada transaksi.</div>
          <a href="/qris" class="glass-btn small primary" style="margin-top:0.8rem;display:inline-flex;">Buat QRIS Pertama</a>
        </div>
      <% } %>
      <% transactions.forEach(function(tx) { %>
        <div class="tx-item" tabindex="0" data-tx='<%- JSON.stringify(tx).replace(/'/g, "&apos;") %>'>
          <div class="tx-info">
            <div class="tx-desc"><%= tx.description || "Pembayaran QRIS" %></div>
            <div class="tx-date"><%= new Date(tx.createdAt).toLocaleString('id-ID', { dateStyle: 'short', timeStyle: 'short' }) %> • ID: <%= tx.id %></div>
          </div>
          <div class="tx-right">
            <div class="tx-amount tabular-nums">Rp <%= Number(tx.totalAmount || tx.amount || 0).toLocaleString('id-ID') %></div>
            <span class="badge <%= tx.status %>"><%= tx.status %></span>
          </div>
        </div>
      <% }) %>
    </div>
  </section>

  <!-- Log Aktivitas -->
  <section class="glass-card" id="activity">
    <div class="section-title">
      <h2>Log Aktivitas Akun</h2>
    </div>
    <div class="activity-list">
      <% if (!activity.length) { %>
        <div class="empty-state">Belum ada aktivitas tercatat.</div>
      <% } %>
      <% activity.forEach(function(act) { %>
        <div class="activity-item">
          <div class="activity-dot"></div>
          <div class="activity-body">
            <div class="activity-detail"><%= act.detail %></div>
            <div class="activity-time"><%= new Date(act.at).toLocaleString('id-ID') %></div>
          </div>
        </div>
      <% }) %>
    </div>
  </section>

  <div class="footer-note">XDigitalKita • Satu dashboard untuk alur pembayaran yang ringkas</div>
</main>

<nav class="bottom-nav<%= isAdmin ? " admin-visible" : "" %>">
  <a href="/dashboard" class="nav-item active"><span class="nav-icon"><svg class="ui-icon" viewBox="0 0 24 24" fill="none" stroke-width="2"><path d="m4 10 8-6 8 6v10H4z"/><path d="M9 20v-6h6v6"/></svg></span><span>Dashboard</span></a>
  <a href="/qris" class="nav-item"><span class="nav-icon"><svg class="ui-icon" viewBox="0 0 24 24" fill="none" stroke-width="2"><path d="M4 4h6v6H4zM14 4h6v6h-6zM4 14h6v6H4z"/><path d="M14 14h3v3h-3zM17 17h3v3h-3z"/></svg></span><span>QRIS</span></a>
  <a href="/withdraw" class="nav-item"><span class="nav-icon"><svg class="ui-icon" viewBox="0 0 24 24" fill="none" stroke-width="2"><path d="M12 4v12"/><path d="m7 11 5 5 5-5"/><path d="M5 20h14"/></svg></span><span>Tarik</span></a>
<% if (isAdmin) { %>
  <a href="/admin" class="nav-item admin-only"><span class="nav-icon"><svg class="ui-icon" viewBox="0 0 24 24" fill="none" stroke-width="2"><path d="M12 3 4 7v5c0 4.6 3.1 7.7 8 9 4.9-1.3 8-4.4 8-9V7z"/><path d="m9 12 2 2 4-4"/></svg></span><span>Admin</span></a>
<% } %>
  <a href="/docs" class="nav-item"><span class="nav-icon"><svg class="ui-icon" viewBox="0 0 24 24" fill="none" stroke-width="2"><path d="M6 4h9l3 3v13H6z"/><path d="M14 4v4h4M9 12h6M9 16h6"/></svg></span><span>Docs</span></a>
  <a href="/profile" class="nav-item"><span class="nav-icon"><svg class="ui-icon" viewBox="0 0 24 24" fill="none" stroke-width="2"><circle cx="12" cy="8" r="3"/><path d="M5 20c1.5-4 12.5-4 14 0"/></svg></span><span>Profil</span></a>
</nav>

<div class="modal" id="txModal" aria-hidden="true">
  <div class="modal-card" role="dialog" aria-modal="true" aria-labelledby="txModalTitle">
    <div class="modal-head">
      <h3 id="txModalTitle">Detail Transaksi</h3>
      <button class="modal-close" type="button" id="closeTxModal" aria-label="Tutup">
        <svg class="ui-icon" viewBox="0 0 24 24" fill="none" stroke-width="2"><path d="m7 7 10 10M17 7 7 17"/></svg>
      </button>
    </div>
    <div class="detail-grid">
      <div class="detail-row"><span>Status</span><strong id="modalTxStatus" class="badge pending">pending</strong></div>
      <div class="detail-row"><span>ID Transaksi</span><code id="modalTxId">-</code></div>
      <div class="detail-row"><span>Keterangan</span><strong id="modalTxDesc">-</strong></div>
      <div class="detail-row"><span>Nominal</span><strong id="modalTxAmount">Rp 0</strong></div>
      <div class="detail-row"><span>Biaya Admin</span><strong id="modalTxFee">Rp 0</strong></div>
      <div class="detail-row total-highlight"><span>Total Tagihan</span><strong id="modalTxTotal">Rp 0</strong></div>
      <div class="detail-row"><span>Waktu Dibuat</span><span id="modalTxTime">-</span></div>
      <div class="detail-row" id="modalPaidRow" style="display:none"><span>Waktu Lunas</span><span id="modalTxPaidTime">-</span></div>
    </div>
    <div class="modal-actions" style="margin-top:1.2rem;display:flex;gap:0.5rem;">
      <button class="glass-btn small primary" id="modalCheckStatusBtn" type="button" style="flex:1;">
        <svg class="ui-icon" viewBox="0 0 24 24" fill="none" stroke-width="2"><path d="M20 11a8 8 0 0 0-14.5-4.5L4 8"/><path d="M4 4v4h4"/><path d="M4 13a8 8 0 0 0 14.5 4.5L20 16"/><path d="M20 20v-4h-4"/></svg>
        <span>Cek Status</span>
      </button>
      <button class="glass-btn small outline" id="modalCopyIdBtn" type="button">Salin ID</button>
    </div>
  </div>
</div>

<script src="/js/main.js"></script>
</body>
</html>
