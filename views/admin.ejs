<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Admin Withdrawal - XDigitalKita</title>
<meta name="description" content="Panel admin XDigitalKita untuk memproses penarikan pengguna.">
<meta name="robots" content="noindex, nofollow, noarchive">
<link rel="icon" href="/icon.svg" type="image/svg+xml">
<link rel="apple-touch-icon" href="/icon.svg">
<link rel="stylesheet" href="/css/glass.css">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet">
<meta name="telegram-channel-url" content="<%= telegramChannelUrl || '' %>">
<meta name="telegram-channel-title" content="<%= telegramChannelTitle || 'Channel Information' %>">
</head>
<body class="glass dark">
<header class="glass-header">
  <div class="brand">
    <span class="brand-mark"><img class="ui-icon" src="/icon.svg" alt=""></span>
    <span>Admin Panel</span>
  </div>
  <div class="header-actions">
    <button class="icon-btn" id="adminRefresh" type="button" aria-label="Refresh">
      <svg class="ui-icon" viewBox="0 0 24 24" fill="none" stroke-width="2"><path d="M20 11a8 8 0 1 0 2 5"/><path d="M20 4v7h-7"/></svg>
    </button>
    <a href="/profile" class="avatar" aria-label="Profil"><%= (user.name || user.email || "A").slice(0, 1).toUpperCase() %></a>
  </div>
</header>

<main class="page">
  <div class="page-title">
    <h1>Withdrawal Management</h1>
    <p>Admin terdeteksi melalui email yang terdaftar di konfigurasi. Approve wajib menyertakan bukti transfer.</p>
  </div>

  <section class="admin-stats-grid">
    <div class="stat-card"><div class="stat-top"><span>Pengguna</span><strong><%= stats.users %></strong></div><span class="admin-stat-note">Total akun</span></div>
    <div class="stat-card pending"><div class="stat-top"><span>Pending</span><strong><%= stats.pending %></strong></div><span class="admin-stat-note">Menunggu diproses</span></div>
    <div class="stat-card success"><div class="stat-top"><span>Disetujui</span><strong><%= stats.approved %></strong></div><span class="admin-stat-note">Selesai</span></div>
    <div class="stat-card failed"><div class="stat-top"><span>Ditolak</span><strong><%= stats.rejected %></strong></div><span class="admin-stat-note">Saldo dikembalikan</span></div>
  </section>

  <div class="alert" id="adminAlert"></div>

  <section class="glass-card admin-pending-summary">
    <div>
      <span class="admin-kicker">TOTAL PENDING</span>
      <strong><%= Number(stats.amountPending || 0).toLocaleString('id-ID') %></strong>
    </div>
    <span>Nilai penarikan yang sedang menunggu persetujuan.</span>
  </section>

  <section class="glass-card">
    <div class="section-title">
      <h2>Daftar Withdrawal</h2>
      <span class="section-link"><%= withdrawals.length %> data</span>
    </div>

    <div class="admin-withdraw-list">
      <% if (!withdrawals.length) { %>
        <div class="empty-state">Belum ada permintaan withdrawal.</div>
      <% } %>

      <% withdrawals.forEach(function(w){ %>
        <article class="admin-withdraw-card <%= w.status %>" data-withdrawal-card>
          <div class="admin-withdraw-head">
            <div>
              <span class="admin-kicker">WITHDRAWAL</span>
              <strong><%= w.id %></strong>
            </div>
            <span class="badge <%= w.status === 'approved' ? 'success' : w.status === 'rejected' ? 'failed' : 'pending' %>"><%= w.status %></span>
          </div>

          <div class="admin-detail-grid">
            <div class="admin-detail"><span>Nama Pengguna</span><strong><%= w.userName || '-' %></strong></div>
            <div class="admin-detail"><span>Email</span><strong><%= w.userEmail || '-' %></strong></div>
            <div class="admin-detail"><span>Saldo Pengguna</span><strong>Rp <%= Number(w.userSaldo || 0).toLocaleString('id-ID') %></strong></div>
            <div class="admin-detail"><span>Nominal Withdrawal</span><strong>Rp <%= Number(w.amount || 0).toLocaleString('id-ID') %></strong></div>
            <div class="admin-detail"><span>Nama Bank / E-Wallet</span><strong><%= w.bank || '-' %></strong></div>
            <div class="admin-detail"><span>Nomor Rekening / Akun</span><strong><%= w.account || '-' %></strong></div>
            <div class="admin-detail"><span>Atas Nama</span><strong><%= w.holder || '-' %></strong></div>
            <div class="admin-detail"><span>Diajukan</span><strong><%= new Date(w.createdAt).toLocaleString('id-ID') %></strong></div>
          </div>

          <% if (w.status === 'rejected') { %>
            <div class="admin-result-box failed-box">
              <span>Alasan ditolak</span>
              <strong><%= w.rejectionReason || '-' %></strong>
            </div>
          <% } %>

          <% if (w.status === 'approved') { %>
            <div class="admin-result-box success-box">
              <span>Diproses oleh</span>
              <strong><%= w.processedByEmail || '-' %> • <%= w.approvedAt ? new Date(w.approvedAt).toLocaleString('id-ID') : '-' %></strong>
            </div>
          <% } %>

          <% if (w.status === 'pending') { %>
            <div class="admin-actions">
              <label class="proof-picker">
                <span>Pilih bukti transfer</span>
                <input data-proof-input type="file" accept="image/jpeg,image/png,image/webp,image/gif,video/mp4,video/webm,application/pdf">
              </label>
              <input class="glass-input admin-reason-input" data-reject-reason type="text" maxlength="240" placeholder="Alasan penolakan (opsional)">
              <div class="admin-action-row">
                <button class="glass-btn danger-btn" data-admin-reject="<%= w.id %>" type="button">Tolak</button>
                <button class="glass-btn primary" data-admin-approve="<%= w.id %>" type="button">Setujui & Kirim Bukti</button>
              </div>
              <small class="admin-proof-note">Bukti wajib untuk Setujui • JPG, PNG, WEBP, GIF, MP4, WEBM, PDF • maksimal 10 MB.</small>
            </div>
          <% } %>
        </article>
      <% }) %>
    </div>
  </section>

  <div class="footer-note">XDigitalKita • Admin Withdrawal</div>
</main>

<nav class="bottom-nav admin-visible">
  <a href="/dashboard" class="nav-item"><span class="nav-icon"><svg class="ui-icon" viewBox="0 0 24 24" fill="none" stroke-width="2"><path d="m4 10 8-6 8 6v10H4z"/><path d="M9 20v-6h6v6"/></svg></span><span>Home</span></a>
  <a href="/qris" class="nav-item"><span class="nav-icon"><svg class="ui-icon" viewBox="0 0 24 24" fill="none" stroke-width="2"><path d="M4 4h6v6H4zM14 4h6v6h-6zM4 14h6v6H4z"/><path d="M14 14h3v3h-3zM17 17h3v3h-3z"/></svg></span><span>QRIS</span></a>
  <a href="/withdraw" class="nav-item"><span class="nav-icon"><svg class="ui-icon" viewBox="0 0 24 24" fill="none" stroke-width="2"><path d="M12 4v12"/><path d="m7 11 5 5 5-5"/><path d="M5 20h14"/></svg></span><span>Tarik</span></a>
  <a href="/docs" class="nav-item"><span class="nav-icon"><svg class="ui-icon" viewBox="0 0 24 24" fill="none" stroke-width="2"><path d="M6 4h9l3 3v13H6z"/><path d="M14 4v4h4M9 12h6M9 16h6"/></svg></span><span>Docs</span></a>
  <a href="/profile" class="nav-item"><span class="nav-icon"><svg class="ui-icon" viewBox="0 0 24 24" fill="none" stroke-width="2"><circle cx="12" cy="8" r="3"/><path d="M5 20c1.5-4 12.5-4 14 0"/></svg></span><span>Profil</span></a>
  <a href="/admin" class="nav-item active admin-only"><span class="nav-icon"><svg class="ui-icon" viewBox="0 0 24 24" fill="none" stroke-width="2"><path d="M12 3 4 7v5c0 4.6 3.1 7.7 8 9 4.9-1.3 8-4.4 8-9V7z"/><path d="m9 12 2 2 4-4"/></svg></span><span>Admin</span></a>
</nav>
<script src="/js/main.js"></script>
</body>
</html>
