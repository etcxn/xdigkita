<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Tarik Saldo (Withdraw) - XDigitalKita</title>
<meta name="description" content="Pencairan saldo hasil transaksi QRIS ke seluruh rekening bank dan e-wallet di Indonesia.">
<meta name="theme-color" content="#0b0b0c">
<meta name="application-name" content="XDigitalKita">
<link rel="canonical" href="https://xdigitalkita.my.id/withdraw">
<link rel="apple-touch-icon" href="/icon.svg">
<meta property="og:site_name" content="XDigitalKita">
<meta property="og:title" content="Tarik Saldo - XDigitalKita">
<meta property="og:description" content="Pencairan dana fleksibel ke rekening bank atau e-wallet.">
<meta property="og:url" content="https://xdigitalkita.my.id/withdraw">
<meta property="og:type" content="website">
<link rel="icon" href="/icon.svg" type="image/svg+xml">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=Space+Grotesk:wght@500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/glass.css">
</head>
<body class="glass dark">

<header class="glass-header">
  <div class="brand">
    <a href="/" class="brand" style="text-decoration:none;">
      <span class="brand-mark"><img class="ui-icon" src="/icon.svg" alt="XDigitalKita"></span>
      <span>Tarik Saldo</span>
    </a>
  </div>
  <div class="header-actions">
    <a href="/dashboard" class="icon-btn" aria-label="Kembali ke Dashboard" title="Dashboard">
      <svg class="ui-icon" viewBox="0 0 24 24" fill="none" stroke-width="2"><path d="m15 18-6-6 6-6"/></svg>
    </a>
  </div>
</header>

<main class="page">
  <div class="page-title">
    <h1>Pencairan Saldo (Withdraw)</h1>
    <p>Minimal penarikan Rp 12.500. Dana diproses ke rekening bank atau e-wallet Anda dengan verifikasi bukti transfer resmi.</p>
  </div>

  <section class="glass-card">
    <div class="saldo-brief" style="display:flex;justify-content:space-between;align-items:center;padding:0.8rem 1rem;background:rgba(255,255,255,0.04);border-radius:14px;border:1px solid rgba(255,255,255,0.1);margin-bottom:1.2rem;">
      <span style="font-size:0.78rem;color:var(--text-muted);font-weight:600;">Saldo Siap Ditarik:</span>
      <strong class="tabular-nums" style="font-size:1.15rem;color:#38bdf8;font-family:'Space Grotesk',sans-serif;">Rp <%= Number(user.saldo || 0).toLocaleString('id-ID') %></strong>
    </div>

    <div class="alert" id="wdAlert"></div>

    <label class="demo-label" for="wdAmount">Jumlah Penarikan (Rp)</label>
    <div class="demo-input-wrap">
      <span class="demo-currency">Rp</span>
      <input class="glass-input demo-input" type="number" id="wdAmount" min="12500" inputmode="numeric" placeholder="12.500">
    </div>

    <!-- Quick Presets -->
    <div class="demo-quick-amounts" style="margin-bottom:1rem;">
      <button type="button" class="quick-val-btn" onclick="document.getElementById('wdAmount').value=12500">12.5k (Min)</button>
      <button type="button" class="quick-val-btn" onclick="document.getElementById('wdAmount').value=25000">25k</button>
      <button type="button" class="quick-val-btn" onclick="document.getElementById('wdAmount').value=50000">50k</button>
      <button type="button" class="quick-val-btn" onclick="document.getElementById('wdAmount').value=100000">100k</button>
      <button type="button" class="quick-val-btn" onclick="document.getElementById('wdAmount').value=<%= Number(user.saldo || 0) %>">Semua</button>
    </div>

    <label class="demo-label">Pilih Bank / E-Wallet Tujuan</label>
    <div class="bank-logos-list" style="margin-bottom:0.9rem;">
      <button type="button" class="bank-pill" style="cursor:pointer;" onclick="document.getElementById('wdBank').value='BCA'">BCA</button>
      <button type="button" class="bank-pill" style="cursor:pointer;" onclick="document.getElementById('wdBank').value='Mandiri'">Mandiri</button>
      <button type="button" class="bank-pill" style="cursor:pointer;" onclick="document.getElementById('wdBank').value='BRI'">BRI</button>
      <button type="button" class="bank-pill" style="cursor:pointer;" onclick="document.getElementById('wdBank').value='BNI'">BNI</button>
      <button type="button" class="bank-pill" style="cursor:pointer;" onclick="document.getElementById('wdBank').value='DANA'">DANA</button>
      <button type="button" class="bank-pill" style="cursor:pointer;" onclick="document.getElementById('wdBank').value='GoPay'">GoPay</button>
      <button type="button" class="bank-pill" style="cursor:pointer;" onclick="document.getElementById('wdBank').value='OVO'">OVO</button>
      <button type="button" class="bank-pill" style="cursor:pointer;" onclick="document.getElementById('wdBank').value='ShopeePay'">ShopeePay</button>
      <button type="button" class="bank-pill" style="cursor:pointer;" onclick="document.getElementById('wdBank').value='SeaBank'">SeaBank</button>
    </div>

    <input class="glass-input" type="text" id="wdBank" placeholder="Nama Bank atau E-Wallet (misal: BCA, DANA)">
    <input class="glass-input" type="text" id="wdAccount" placeholder="Nomor Rekening / No. HP E-Wallet">
    <input class="glass-input" type="text" id="wdHolder" placeholder="Nama Pemilik Rekening (sesuai buku tabungan)">

    <button class="glass-btn primary" id="wdBtn" type="button" style="width:100%;min-height:48px;font-size:0.95rem;margin-top:0.8rem;">
      <svg class="ui-icon" viewBox="0 0 24 24" fill="none" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
      <span>Ajukan Penarikan Dana</span>
    </button>
  </section>

  <!-- Riwayat Penarikan -->
  <section class="glass-card">
    <div class="section-title">
      <h2>Riwayat Penarikan</h2>
    </div>
    <div class="tx-list">
      <% if (!withdrawals.length) { %>
        <div class="empty-state">
          <svg class="ui-icon" viewBox="0 0 24 24" fill="none" stroke-width="1.5" style="width:36px;height:36px;margin:0 auto 0.5rem;color:var(--text-muted);"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 14 14"/></svg>
          <div>Belum ada riwayat penarikan dana.</div>
        </div>
      <% } %>
      <% withdrawals.forEach(function(w) { %>
        <div class="tx-item" tabindex="0">
          <div class="tx-info">
            <div class="tx-desc tabular-nums" style="font-weight:700;">Rp <%= Number(w.amount || 0).toLocaleString('id-ID') %></div>
            <div class="tx-date"><%= w.bank %> • <%= w.account %> (<%= w.holder %>)</div>
            <div class="tx-date" style="font-size:0.68rem;color:var(--text-dim);"><%= new Date(w.createdAt).toLocaleString('id-ID') %> • ID: <%= w.id %></div>
          </div>
          <span class="badge <%= w.status %>"><%= w.status %></span>
        </div>
      <% }) %>
    </div>
  </section>
</main>

<nav class="bottom-nav<%= isAdmin ? " admin-visible" : "" %>">
  <a href="/dashboard" class="nav-item"><span class="nav-icon"><svg class="ui-icon" viewBox="0 0 24 24" fill="none" stroke-width="2"><path d="m4 10 8-6 8 6v10H4z"/><path d="M9 20v-6h6v6"/></svg></span><span>Dashboard</span></a>
  <a href="/qris" class="nav-item"><span class="nav-icon"><svg class="ui-icon" viewBox="0 0 24 24" fill="none" stroke-width="2"><path d="M4 4h6v6H4zM14 4h6v6h-6zM4 14h6v6H4z"/><path d="M14 14h3v3h-3zM17 17h3v3h-3z"/></svg></span><span>QRIS</span></a>
  <a href="/withdraw" class="nav-item active"><span class="nav-icon"><svg class="ui-icon" viewBox="0 0 24 24" fill="none" stroke-width="2"><path d="M12 4v12"/><path d="m7 11 5 5 5-5"/><path d="M5 20h14"/></svg></span><span>Tarik</span></a>
<% if (isAdmin) { %>
  <a href="/admin" class="nav-item admin-only"><span class="nav-icon"><svg class="ui-icon" viewBox="0 0 24 24" fill="none" stroke-width="2"><path d="M12 3 4 7v5c0 4.6 3.1 7.7 8 9 4.9-1.3 8-4.4 8-9V7z"/><path d="m9 12 2 2 4-4"/></svg></span><span>Admin</span></a>
<% } %>
  <a href="/docs" class="nav-item"><span class="nav-icon"><svg class="ui-icon" viewBox="0 0 24 24" fill="none" stroke-width="2"><path d="M6 4h9l3 3v13H6z"/><path d="M14 4v4h4M9 12h6M9 16h6"/></svg></span><span>Docs</span></a>
  <a href="/profile" class="nav-item"><span class="nav-icon"><svg class="ui-icon" viewBox="0 0 24 24" fill="none" stroke-width="2"><circle cx="12" cy="8" r="3"/><path d="M5 20c1.5-4 12.5-4 14 0"/></svg></span><span>Profil</span></a>
</nav>

<script src="/js/main.js"></script>
</body>
</html>
