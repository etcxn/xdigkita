<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Profil &amp; API Key - XDigitalKita</title>
<meta name="description" content="Manajemen akun, kredensial API Key H2H, dan riwayat profil XDigitalKita.">
<meta name="theme-color" content="#0b0b0c">
<meta name="application-name" content="XDigitalKita">
<link rel="canonical" href="https://xdigitalkita.my.id/profile">
<link rel="apple-touch-icon" href="/icon.svg">
<meta property="og:site_name" content="XDigitalKita">
<meta property="og:title" content="Profil - XDigitalKita">
<meta property="og:url" content="https://xdigitalkita.my.id/profile">
<meta property="og:type" content="website">
<link rel="icon" href="/icon.svg" type="image/svg+xml">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=Space+Grotesk:wght@500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/glass.css">
</head>
<body class="glass dark">

<header class="glass-header">
  <div class="brand">
    <a href="/" class="brand" style="text-decoration:none;">
      <span class="brand-mark"><img class="ui-icon" src="/icon.svg" alt="XDigitalKita"></span>
      <span>Profil Saya</span>
    </a>
  </div>
  <div class="header-actions">
    <a href="/dashboard" class="icon-btn" aria-label="Dashboard" title="Dashboard">
      <svg class="ui-icon" viewBox="0 0 24 24" fill="none" stroke-width="2"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
    </a>
    <button class="icon-btn" id="themeBtn" type="button" aria-label="Ganti tema">
      <svg class="ui-icon" id="themeIcon" viewBox="0 0 24 24" fill="none" stroke-width="2"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/></svg>
    </button>
  </div>
</header>

<main class="page">
  <div class="page-title">
    <h1>Akun &amp; Kredensial</h1>
    <p>Kelola data akun, informasi saldo, dan API Key untuk integrasi aplikasi pihak ketiga.</p>
  </div>

  <!-- Profile Card -->
  <section class="glass-card">
    <div class="profile-head" style="display:flex;align-items:center;gap:1.1rem;margin-bottom:1.2rem;">
      <div class="profile-avatar"<% if (user.avatar) { %> style="background-image:url('<%= user.avatar %>')"<% } %>>
        <% if (!user.avatar) { %><%= user.name ? user.name[0].toUpperCase() : "U" %><% } %>
      </div>
      <div class="profile-copy">
        <h2 style="font-family:'Space Grotesk',sans-serif;font-size:1.3rem;font-weight:800;margin-bottom:0.2rem;"><%= user.name || "Pengguna XDigitalKita" %></h2>
        <p style="color:var(--text-muted);font-size:0.8rem;"><%= user.email %></p>
      </div>
    </div>

    <div class="info-list">
      <div class="info-row">
        <span>Metode Login</span>
        <strong style="text-transform:uppercase;"><%= user.provider || "local" %></strong>
      </div>
      <div class="info-row">
        <span>Saldo Tersedia</span>
        <strong class="tabular-nums" style="color:#38bdf8;">Rp <%= Number(user.saldo || 0).toLocaleString('id-ID') %></strong>
      </div>
      <div class="info-row">
        <span>Tanggal Bergabung</span>
        <strong><%= new Date(user.createdAt).toLocaleDateString('id-ID', { dateStyle: 'long' }) %></strong>
      </div>
      <div class="info-row">
        <span>User ID</span>
        <code style="font-family:'JetBrains Mono',monospace;color:var(--text-muted);font-size:0.75rem;"><%= user.id %></code>
      </div>
    </div>
  </section>

  <!-- API Key Box -->
  <section class="glass-card">
    <div class="section-title">
      <h2>API Key H2H</h2>
      <a href="/docs" class="section-link" style="color:#38bdf8;">Baca Dokumentasi API</a>
    </div>
    
    <p style="font-size:0.8rem;color:var(--text-muted);margin-bottom:0.8rem;line-height:1.5;">
      Gunakan API Key ini di header <code>X-API-Key</code> untuk membuat QRIS dan mengecek status transaksi dari backend Anda.
    </p>

    <div class="api-key-box" style="display:flex;flex-direction:column;gap:0.75rem;padding:0.9rem;background:#090710;border-radius:14px;border:1px solid rgba(255,255,255,0.12);">
      <code id="apiKey" style="font-family:'JetBrains Mono',monospace;font-size:0.82rem;color:#38bdf8;word-break:break-all;"><%= user.apiKey %></code>
      <div class="api-actions" style="display:flex;gap:0.5rem;">
        <button class="glass-btn small primary" id="copyKey" type="button" style="flex:1;">
          <svg class="ui-icon" viewBox="0 0 24 24" fill="none" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
          <span>Salin API Key</span>
        </button>
        <button class="glass-btn small outline" id="regenKey" type="button">
          <svg class="ui-icon" viewBox="0 0 24 24" fill="none" stroke-width="2"><path d="M20 11a8 8 0 0 0-14.5-4.5L4 8"/><path d="M4 4v4h4"/><path d="M4 13a8 8 0 0 0 14.5 4.5L20 16"/><path d="M20 20v-4h-4"/></svg>
          <span>Regenerasi</span>
        </button>
      </div>
    </div>
    <p style="margin-top:0.6rem;color:var(--text-dim);font-size:0.68rem;line-height:1.5">
      ⚠️ Regenerasi API Key akan langsung menonaktifkan key lama pada semua bot dan skrip yang terhubung.
    </p>
  </section>

  <!-- Logout Section -->
  <section class="glass-card">
    <h2>Sesi &amp; Keamanan</h2>
    <p style="font-size:0.8rem;color:var(--text-muted);margin-bottom:0.9rem;">Keluar dari sesi browser saat ini untuk menjaga keamanan akun Anda.</p>
    <button class="glass-btn outline" id="logoutBtn" type="button" style="width:100%;color:#ff668a;border-color:rgba(255,102,138,0.3);">
      <svg class="ui-icon" viewBox="0 0 24 24" fill="none" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
      <span>Keluar dari Akun</span>
    </button>
  </section>
</main>

<nav class="bottom-nav<%= isAdmin ? " admin-visible" : "" %>">
  <a href="/dashboard" class="nav-item"><span class="nav-icon"><svg class="ui-icon" viewBox="0 0 24 24" fill="none" stroke-width="2"><path d="m4 10 8-6 8 6v10H4z"/><path d="M9 20v-6h6v6"/></svg></span><span>Dashboard</span></a>
  <a href="/qris" class="nav-item"><span class="nav-icon"><svg class="ui-icon" viewBox="0 0 24 24" fill="none" stroke-width="2"><path d="M4 4h6v6H4zM14 4h6v6h-6zM4 14h6v6H4z"/><path d="M14 14h3v3h-3zM17 17h3v3h-3z"/></svg></span><span>QRIS</span></a>
  <a href="/withdraw" class="nav-item"><span class="nav-icon"><svg class="ui-icon" viewBox="0 0 24 24" fill="none" stroke-width="2"><path d="M12 4v12"/><path d="m7 11 5 5 5-5"/><path d="M5 20h14"/></svg></span><span>Tarik</span></a>
<% if (isAdmin) { %>
  <a href="/admin" class="nav-item admin-only"><span class="nav-icon"><svg class="ui-icon" viewBox="0 0 24 24" fill="none" stroke-width="2"><path d="M12 3 4 7v5c0 4.6 3.1 7.7 8 9 4.9-1.3 8-4.4 8-9V7z"/><path d="m9 12 2 2 4-4"/></svg></span><span>Admin</span></a>
<% } %>
  <a href="/docs" class="nav-item"><span class="nav-icon"><svg class="ui-icon" viewBox="0 0 24 24" fill="none" stroke-width="2"><path d="M6 4h9l3 3v13H6z"/><path d="M14 4v4h4M9 12h6M9 16h6"/></svg></span><span>Docs</span></a>
  <a href="/profile" class="nav-item active"><span class="nav-icon"><svg class="ui-icon" viewBox="0 0 24 24" fill="none" stroke-width="2"><circle cx="12" cy="8" r="3"/><path d="M5 20c1.5-4 12.5-4 14 0"/></svg></span><span>Profil</span></a>
</nav>

<script src="/js/main.js"></script>
</body>
</html>
